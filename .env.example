# ============================================================
# nice-admin 环境配置示例
# 复制为 .env 后按需修改。切勿把真实密钥提交到仓库。
# ============================================================

# ---------- 通用 ----------
NODE_ENV=development
TZ=Asia/Shanghai

# ---------- 后端 API ----------
API_PORT=3000
API_PREFIX=/api
# 前端访问地址，用于 CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- 数据库类型 ----------
# 支持 postgresql(默认) 或 mysql。切换后需重新执行 db:generate / db:push。
DB_PROVIDER=postgresql

# ---------- PostgreSQL（DB_PROVIDER=postgresql 时使用） ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nice
POSTGRES_PASSWORD=nice_pwd_change_me
POSTGRES_DB=nice_admin
# Prisma 连接串（容器内用服务名 postgres；本机开发用 localhost）
DATABASE_URL=postgresql://nice:nice_pwd_change_me@postgres:5432/nice_admin?schema=public

# ---------- MySQL（DB_PROVIDER=mysql 时使用，配合 docker-compose.mysql.yml） ----------
# MYSQL_ROOT_PASSWORD=root_pwd_change_me
# MYSQL_USER=nice
# MYSQL_PASSWORD=nice_pwd_change_me
# MYSQL_DB=nice_admin
# 切到 MySQL 时把上面的 DATABASE_URL 改为下面这行（容器内用服务名 mysql；本机用 localhost:3306）
# DATABASE_URL=mysql://nice:nice_pwd_change_me@mysql:3306/nice_admin

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
JWT_ACCESS_SECRET=please_change_this_access_secret
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_SECRET=please_change_this_refresh_secret
JWT_REFRESH_EXPIRES=7d

# ---------- 文件上传 ----------
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=20

# ---------- 安全(P0 安全基线) ----------
# 登录失败锁定
SEC_LOGIN_MAX_FAIL=5
SEC_LOGIN_FAIL_WINDOW_MIN=15
SEC_LOGIN_LOCK_MIN=15
# 密码策略
SEC_PWD_MIN_LENGTH=8
SEC_PWD_REQUIRE_UPPER=true
SEC_PWD_REQUIRE_LOWER=true
SEC_PWD_REQUIRE_NUMBER=true
SEC_PWD_REQUIRE_SPECIAL=false
SEC_PWD_EXPIRE_DAYS=0
# MFA(二次验证)
SEC_MFA_CHALLENGE_EXPIRES=5m
SEC_MFA_ISSUER=nice-admin
# 接口限流(0=按接口装饰器为准；这里是全局默认兜底)
SEC_RATE_LIMIT_DEFAULT=0
SEC_RATE_LIMIT_WINDOW_SEC=60

# ---------- 默认超级管理员（种子数据用） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- 前端构建期变量 ----------
# 前端请求的 API 基础地址（生产由 nginx 反代到 /api）
VITE_API_BASE_URL=/api
VITE_WS_URL=/socket.io
